FROM apache/airflow:2.9.3-python3.12

# Pin dbt-core explicitly to match dbt-postgres (same major.minor required)
# boto3, tenacity already in base image; postgres provider already installed
RUN pip install --no-cache-dir \
    "dbt-core==1.8.2" \
    "dbt-postgres==1.8.2" \
    "facebook-business==20.0.3"
